{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tator",
  "version": "0.1.0",
  "identifier": "dev.kevcoxe.tator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tator",
        "width": 960,
        "height": 920,
        "minWidth": 720,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "infoPlist": "./Info.plist"
    }
  }
}
