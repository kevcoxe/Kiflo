{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiflo",
  "version": "0.3.4",
  "identifier": "dev.kevcoxe.kiflo",
  "build": {
    "beforeDevCommand": "npm run prepare:whisper-assets && npm run dev",
    "beforeBuildCommand": "npm run prepare:whisper-assets && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiflo",
        "width": 960,
        "height": 920,
        "minWidth": 720,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "target/bundled-whisper-model/": "whisper/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "./Info.plist",
      "entitlements": "./entitlements.plist"
    }
  }
}
