{
  "name": "tator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/shared-types"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:desktop": "npm run dev --workspace @tator/desktop",
    "debug:desktop:release:local": "bash ./scripts/debug-desktop-release-local.sh",
    "release:prep": "node ./scripts/release-prep.mjs",
    "sync:desktop-version": "node ./scripts/sync-desktop-version.mjs",
    "tauri:dev": "npm run tauri:dev --workspace @tator/desktop",
    "test": "npm run test --workspace @tator/desktop && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:desktop": "npm run test --workspace @tator/desktop",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml"
  }
}
